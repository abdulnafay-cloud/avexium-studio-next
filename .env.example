# Copy into private .env.local. Never commit actual values.
APP_URL=http://localhost:3002
DATABASE_URL=
DATABASE_URL_POOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
ADMIN_OWNER_EMAIL=
# Leave blank locally. Set an HTTPS origin only when preparing the real deployment.
PUBLIC_SITE_URL=
# Generate 32 random bytes as hex; keep a separate secure copy outside the backups.
BACKUP_ENCRYPTION_KEY=
# Dry-run retention defaults; review before using --apply.
APPLICATION_RETENTION_DAYS=180
ENQUIRY_RETENTION_DAYS=365
# Optional live notification delivery. Nothing sends unless worker has --send.
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_TO=
